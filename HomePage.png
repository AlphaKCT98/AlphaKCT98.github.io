:root {
  --bg: #eef4fb;
  --bg-soft: #f7faff;
  --surface: #ffffff;
  --surface-alt: #f3f7fe;
  --surface-strong: #e9f1ff;
  --text: #18253d;
  --muted: #58657a;
  --accent: #1d4ed8;
  --accent-dark: #153b9b;
  --accent-soft: rgba(29, 78, 216, 0.12);
  --border: #cdd8ea;
  --success: #166534;
  --success-soft: #ecfdf3;
  --danger: #b42318;
  --danger-soft: #fff1f2;
  --shadow: 0 14px 32px rgba(15, 23, 42, 0.08);
  --shadow-soft: 0 6px 18px rgba(15, 23, 42, 0.06);
  --radius: 18px;
  --radius-sm: 12px;
  --max-width: 1120px;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.65;
  background:
    radial-gradient(circle at top right, rgba(29, 78, 216, 0.08), transparent 28%),
    linear-gradient(180deg, #f8fbff 0%, var(--bg) 100%);
}

img {
  display: block;
  max-width: 100%;
  border-radius: var(--radius-sm);
}

a {
  color: var(--accent);
  text-decoration: none;
  transition: color 0.2s ease, background-color 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
}

a:hover,
a:focus-visible {
  color: var(--accent-dark);
  text-decoration: underline;
}

button,
input,
select,
textarea {
  font: inherit;
}

.skip-link {
  position: absolute;
  left: -9999px;
  top: 0;
}

.skip-link:focus {
  left: 1rem;
  top: 1rem;
  background: #fff;
  border: 2px solid var(--accent);
  padding: 0.8rem 1rem;
  border-radius: 10px;
  z-index: 200;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(205, 216, 234, 0.9);
}

.header-inner,
.page-shell,
.footer-inner {
  width: min(var(--max-width), calc(100% - 2rem));
  margin: 0 auto;
}

.header-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem 1.5rem;
  padding: 1rem 0;
}

.branding {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}

#site-title {
  color: var(--text);
  font-weight: 700;
  font-size: 1.2rem;
}

.branding p {
  margin: 0;
  color: var(--muted);
  font-size: 0.94rem;
}

.site-nav ul {
  margin: 0;
  padding: 0;
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  justify-content: flex-end;
}

.site-nav a {
  display: inline-block;
  padding: 0.55rem 0.9rem;
  border: 1px solid transparent;
  border-radius: 999px;
  font-weight: 700;
  font-size: 0.95rem;
}

.site-nav a:hover,
.site-nav a:focus-visible {
  background: var(--surface-alt);
  text-decoration: none;
  transform: translateY(-1px);
}

.site-nav a.active {
  background: var(--accent);
  color: #fff;
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
}

.page-shell {
  padding: 2rem 0 3rem;
}

.hero,
.content-card,
.figure-card,
.callout,
.table-wrap,
.stat-box,
.definition-card,
.resume-card,
.highlight-box,
.quiz-form,
.quiz-results,
.timeline-strip,
.mini-card,
.study-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow-soft);
}

.hero {
  padding: 2rem;
  margin-bottom: 1.5rem;
  background:
    linear-gradient(135deg, rgba(29, 78, 216, 0.06), rgba(255, 255, 255, 0.95)),
    var(--surface);
}

.hero-grid,
.two-column,
.cards-grid,
.summary-grid,
.metric-grid,
.study-grid,
.section-grid {
  display: grid;
  gap: 1.25rem;
}

.hero-grid {
  grid-template-columns: 1.35fr 1fr;
  align-items: center;
}

.two-column {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: 1.5rem;
}

.cards-grid,
.summary-grid,
.metric-grid,
.study-grid,
.section-grid {
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
}

.page-section {
  margin-bottom: 1.5rem;
}

.hero h1,
.content-card h2,
.figure-card h2,
.callout h2,
.resume-card h2,
.highlight-box h2,
.table-wrap h2,
.definition-card h2,
.mini-card h3,
.study-card h3 {
  line-height: 1.2;
}

.hero h1 {
  margin: 0.1rem 0 0.8rem;
  font-size: clamp(2rem, 4vw, 3.2rem);
}

.hero p,
.content-card p,
.figure-card p,
.callout p,
.resume-card p,
.highlight-box p,
.definition-card p,
.mini-card p,
.study-card p {
  margin-top: 0;
}

.eyebrow,
.small-note {
  display: inline-block;
  margin: 0 0 0.6rem;
  color: var(--accent-dark);
  background: var(--accent-soft);
  border: 1px solid rgba(29, 78, 216, 0.12);
  border-radius: 999px;
  padding: 0.25rem 0.65rem;
  font-size: 0.88rem;
  font-weight: 700;
}

.subhead {
  color: var(--muted);
  font-size: 1.06rem;
  max-width: 65ch;
}

.hero-actions,
.badge-row,
.tag-list,
.footer-links,
.inline-links,
.topic-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.65rem;
}

.badge,
.tag-list span,
.pill {
  background: var(--surface-alt);
  border: 1px solid var(--border);
  color: var(--accent-dark);
  border-radius: 999px;
  padding: 0.35rem 0.7rem;
  font-size: 0.92rem;
  font-weight: 700;
}

.content-card,
.figure-card,
.callout,
.resume-card,
.definition-card,
.highlight-box,
.mini-card,
.study-card {
  padding: 1.35rem;
}

.content-card ul,
.content-card ol,
.resume-card ul,
.highlight-box ul,
.study-card ul {
  padding-left: 1.25rem;
}

.figure-card img {
  width: 100%;
  box-shadow: var(--shadow-soft);
}

.metric-grid {
  margin-top: 1.1rem;
}

.stat-box {
  padding: 1rem;
  background: linear-gradient(180deg, #ffffff, #f7fbff);
}

.stat-box h3 {
  margin: 0 0 0.35rem;
  font-size: 1rem;
}

.definition-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 1rem;
}

.definition-list div {
  padding: 1rem;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border);
  background: var(--surface-alt);
}

.definition-list dt {
  margin-bottom: 0.35rem;
  font-weight: 700;
}

.definition-list dd {
  margin: 0;
  color: var(--muted);
}

.section-heading {
  margin-bottom: 0.85rem;
}

.section-heading h2 {
  margin: 0 0 0.35rem;
}

.section-heading p {
  margin: 0;
  color: var(--muted);
}

.info-list {
  display: grid;
  gap: 0.85rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.info-list li {
  background: var(--surface-alt);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 0.9rem 1rem;
}

.timeline-strip {
  padding: 1.15rem;
}

.timeline-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 1rem;
  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
}

.timeline-list li {
  position: relative;
  padding: 1rem;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border);
  background: linear-gradient(180deg, #ffffff, var(--surface-alt));
}

.timeline-list strong {
  display: block;
  color: var(--accent-dark);
  font-size: 1.15rem;
  margin-bottom: 0.25rem;
}

figure {
  margin: 0;
}

figcaption {
  margin-top: 0.8rem;
  color: var(--muted);
  font-size: 0.94rem;
}

.table-wrap {
  padding: 1rem;
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  background: #fff;
}

caption {
  caption-side: top;
  text-align: left;
  font-weight: 700;
  padding-bottom: 0.8rem;
}

th,
td {
  padding: 0.82rem;
  border: 1px solid var(--border);
  text-align: left;
  vertical-align: top;
}

th {
  background: #edf3fe;
}

.callout {
  border-left: 6px solid var(--accent);
  background: linear-gradient(180deg, rgba(29, 78, 216, 0.03), #ffffff);
}

.note-box {
  padding: 1rem 1.05rem;
  border-radius: var(--radius-sm);
  border: 1px dashed rgba(29, 78, 216, 0.35);
  background: rgba(29, 78, 216, 0.05);
}

.quick-facts {
  display: grid;
  gap: 0.9rem;
}

.quick-facts .fact {
  padding: 0.95rem 1rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--surface-alt);
}

.quick-facts h3 {
  margin: 0 0 0.3rem;
  font-size: 1rem;
}

code {
  background: #e9f1ff;
  padding: 0.12rem 0.34rem;
  border-radius: 6px;
}

.page-footer {
  background: rgba(255, 255, 255, 0.96);
  border-top: 1px solid var(--border);
}

.footer-inner {
  padding: 1.35rem 0 2rem;
  color: var(--muted);
}

.footer-links {
  margin-top: 0.5rem;
}

#project-note {
  margin-top: 1rem;
  padding: 0.95rem 1rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--surface-alt);
}

.author-hero {
  align-items: stretch;
}

.author-image {
  max-height: 520px;
  object-fit: cover;
  width: 100%;
}

.project-table td:first-child,
.project-table th:first-child {
  width: 24%;
}

.study-grid {
  margin-top: 1rem;
}

.study-card {
  background: linear-gradient(180deg, #fff, #f7fbff);
}

.study-card a {
  font-weight: 700;
}

.quiz-layout {
  align-items: stretch;
}

.quiz-form,
.quiz-results {
  padding: 1.5rem;
  margin-bottom: 1.5rem;
}

.quiz-fieldset {
  margin: 0 0 1rem;
  padding: 1.1rem 1.1rem 1rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: #fbfdff;
}

.quiz-fieldset legend {
  padding: 0 0.45rem;
  font-weight: 700;
  color: var(--accent-dark);
}

.choice-list {
  display: grid;
  gap: 0.75rem;
  margin-top: 0.9rem;
}

.choice-list label {
  display: flex;
  align-items: flex-start;
  gap: 0.7rem;
  padding: 0.82rem 0.95rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: #fff;
  cursor: pointer;
  transition: border-color 0.2s ease, transform 0.2s ease, background-color 0.2s ease;
}

.choice-list label:hover,
.choice-list label:focus-within {
  border-color: var(--accent);
  background: var(--surface-alt);
  transform: translateY(-1px);
}

.choice-list input[type="radio"],
.choice-list input[type="checkbox"] {
  margin-top: 0.22rem;
  accent-color: var(--accent);
}

.text-answer {
  width: 100%;
  margin-top: 0.85rem;
  padding: 0.85rem 1rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  color: var(--text);
}

.text-answer:focus {
  outline: 2px solid rgba(29, 78, 216, 0.15);
  border-color: var(--accent);
}

.quiz-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.9rem;
  margin-top: 1.25rem;
}

.button-primary,
.button-secondary,
.button-link {
  display: inline-block;
  border: 1px solid transparent;
  border-radius: 999px;
  padding: 0.8rem 1.15rem;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
}

.button-primary,
.button-link {
  background: var(--accent);
  color: #fff;
}

.button-primary:hover,
.button-primary:focus-visible,
.button-link:hover,
.button-link:focus-visible {
  background: var(--accent-dark);
  color: #fff;
  text-decoration: none;
  transform: translateY(-1px);
}

.button-secondary {
  background: #fff;
  color: var(--text);
  border-color: var(--border);
}

.button-secondary:hover,
.button-secondary:focus-visible {
  background: var(--surface-alt);
  border-color: var(--accent);
  text-decoration: none;
  transform: translateY(-1px);
}

.result-summary {
  padding: 1.15rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  margin-bottom: 1rem;
}

.pass-summary {
  background: var(--success-soft);
  border-color: #8ed0a8;
  color: var(--success);
}

.fail-summary {
  background: var(--danger-soft);
  border-color: #efabb2;
  color: var(--danger);
}

.result-details {
  display: grid;
  gap: 1rem;
}

.result-card {
  padding: 1rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: #fff;
}

.result-card h3 {
  margin: 0 0 0.5rem;
}

.correct-card {
  border-left: 6px solid #22a35a;
  background: #f6fff9;
}

.incorrect-card {
  border-left: 6px solid #e04f5f;
  background: #fff8f8;
}

.result-explanation {
  color: var(--muted);
}

.resource-list {
  display: grid;
  gap: 0.9rem;
}

.resource-list li {
  background: var(--surface-alt);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 0.9rem 1rem;
}

.link-section h2 {
  margin-top: 0;
}

.compact-list {
  margin: 0;
  padding-left: 1.2rem;
}

.small-text {
  color: var(--muted);
  font-size: 0.94rem;
}

@media (max-width: 940px) {
  .header-inner,
  .hero-grid,
  .two-column {
    display: grid;
    grid-template-columns: 1fr;
  }

  .site-nav ul {
    justify-content: flex-start;
  }
}

@media (max-width: 640px) {
  .page-shell {
    padding-top: 1.15rem;
  }

  .hero,
  .content-card,
  .figure-card,
  .callout,
  .resume-card,
  .definition-card,
  .highlight-box,
  .mini-card,
  .study-card,
  .quiz-form,
  .quiz-results {
    padding: 1rem;
  }

  .quiz-fieldset {
    padding: 0.95rem;
  }

  .site-nav a {
    padding: 0.5rem 0.75rem;
  }

  .header-inner,
  .page-shell,
  .footer-inner {
    width: min(var(--max-width), calc(100% - 1rem));
  }
}

/* Final responsive design improvements
   I added these extra breakpoints to make the site work better on desktops, tablets, and phones. */
@media (max-width: 1100px) {
  .header-inner {
    align-items: flex-start;
  }

  .site-nav ul {
    max-width: 760px;
  }

  .hero-grid {
    gap: 1rem;
  }
}

/* Tablet layout: the menu wraps nicely and two-column sections become one column when space gets tight. */
@media (max-width: 760px) {
  .site-header {
    position: static;
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr;
  }

  .site-nav ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: 100%;
  }

  .site-nav a {
    display: block;
    text-align: center;
  }

  .hero h1 {
    font-size: clamp(1.75rem, 8vw, 2.35rem);
  }

  .subhead {
    font-size: 1rem;
  }

  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  table {
    min-width: 620px;
  }

  .figure-card img,
  .author-image {
    height: auto;
    max-height: none;
    object-fit: contain;
  }

  .quiz-actions {
    flex-direction: column;
  }

  .button-primary,
  .button-secondary,
  .button-link {
    width: 100%;
    text-align: center;
  }
}

/* Phone layout: this keeps the page from feeling squeezed on smaller screens. */
@media (max-width: 480px) {
  body {
    line-height: 1.55;
  }

  .site-nav ul {
    grid-template-columns: 1fr;
    gap: 0.4rem;
  }

  .badge-row,
  .hero-actions,
  .footer-links {
    flex-direction: column;
  }

  .badge,
  .tag-list span,
  .pill {
    width: fit-content;
  }

  .choice-list label {
    padding: 0.95rem;
  }

  .text-answer {
    min-height: 48px;
  }

  .resource-list,
  .compact-list {
    overflow-wrap: anywhere;
  }

  th,
  td {
    padding: 0.7rem;
  }
}

